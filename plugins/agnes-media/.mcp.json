{
  "mcpServers": {
    "agnes-media": {
      "type": "stdio",
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/server/index.mjs"],
      "env": {
        "AGNES_API_KEY": "${user_config.apiKey}",
        "AGNES_BASE_URL": "${user_config.baseUrl}",
        "AGNES_MEDIA_PROVIDER": "${user_config.provider}",
        "AGNES_IMAGE_MODEL": "${user_config.imageModel}",
        "AGNES_VIDEO_MODEL": "${user_config.videoModel}",
        "AGNES_IMAGE_MODELS": "${user_config.imageModels}",
        "AGNES_VIDEO_MODELS": "${user_config.videoModels}",
        "AGNES_MEDIA_SAVE_DIR": "${user_config.saveDir}"
      },
      "enabled": true,
      "timeoutMs": 30000
    }
  }
}
